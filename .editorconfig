root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
# External: https://kotlinlang.org/docs/coding-conventions.html The Kotlin coding conventions use four spaces.
indent_size = 4
# ADR-010
max_line_length = 120
ktlint_code_style = ktlint_official
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
